{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunatic Princess",
  "version": "2.2.5",
  "identifier": "io.github.tsukimi-mizuki.lunaticprincess",
  "mainBinaryName": "LunaticPrincess",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lunatic Princess",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "publisher": "Tsukimi-Mizuki",
    "copyright": "Copyright (c) Tsukimi-Mizuki. Licensed under AGPL-3.0.",
    "category": "Music",
    "shortDescription": "Lunatic Princess",
    "longDescription": "网易云音乐歌单同步、NCM 解密、歌词与标签管理工具。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
