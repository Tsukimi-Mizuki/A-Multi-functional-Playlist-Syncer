<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NeteaseMusicManager.Desktop.Views.LyricsEditorWindow"
        Title="歌词与标签编辑器"
        Width="1240" Height="820"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <!-- 顶栏 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="歌词与标签编辑" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{Binding FileName}" FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   MaxLines="1" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="1" Content="打开音频文件" Command="{Binding OpenFileCommand}"
              Padding="18,7" AutomationProperties.Name="打开音频文件" />
      <Button Grid.Column="2" Content="重新读取" Command="{Binding ReloadCommand}"
              Padding="18,7" AutomationProperties.Name="重新读取标签" />
    </Grid>

    <!-- 左侧标签 + 右侧歌词 -->
    <Grid Grid.Row="1" ColumnDefinitions="360,14,*" Margin="0,14,0,0">
      <Border Grid.Column="0" Classes="salt-card" Padding="16" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="0,0,8,0">
            <TextBlock Classes="salt-card-title" Text="标签信息" />

            <StackPanel Spacing="3">
              <TextBlock Text="标题" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
              <TextBox Text="{Binding Title, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Text="艺术家（多个用 / 分隔）" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
              <TextBox Text="{Binding Artist, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Text="专辑" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
              <TextBox Text="{Binding Album, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Text="专辑艺术家" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
              <TextBox Text="{Binding AlbumArtist, Mode=TwoWay}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,8,*,8,*" ColumnSpacing="0">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="年份" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
                <TextBox Text="{Binding Year, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="3">
                <TextBlock Text="音轨号" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
                <TextBox Text="{Binding TrackNumber, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="3">
                <TextBlock Text="碟号" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
                <TextBox Text="{Binding DiscNumber, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="3">
              <TextBlock Text="风格" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
              <TextBox Text="{Binding Genre, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Text="作曲家（多个用 / 分隔）" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
              <TextBox Text="{Binding Composer, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Text="注释" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
              <TextBox Text="{Binding Comment, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock Classes="salt-card-title" Text="封面" Margin="0,6,0,0" />
            <Border Width="120" Height="120" CornerRadius="8" ClipToBounds="True"
                    Background="{StaticResource PanelHoverBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Left">
              <Panel>
                <TextBlock Text="♪" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}" />
                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
              </Panel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Classes="salt-card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="16,14,16,8" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="歌词" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="直接编辑并写入音频标签；支持 LRC / 逐字歌词文本。"
                         FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding LyricsLengthText}" FontSize="10.5"
                       VerticalAlignment="Bottom" Foreground="{StaticResource TextTertiaryBrush}" />
          </Grid>
          <TextBox Grid.Row="1" Margin="12,0,12,12"
                   Text="{Binding Lyrics, Mode=TwoWay}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontFamily="Consolas, Microsoft YaHei UI"
                   FontSize="12"
                   VerticalAlignment="Stretch"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Watermark="在此输入或粘贴歌词；保存后会写入音频文件的歌词标签。" />
        </Grid>
      </Border>
    </Grid>

    <!-- 底栏 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,14,0,0">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding FileInfoText}" FontSize="10.5"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   MaxLines="1" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding StatusText}" FontSize="11"
                   Foreground="{StaticResource TextTertiaryBrush}"
                   MaxLines="1" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="1" Classes="primary" Content="保存标签与歌词"
              Command="{Binding SaveCommand}" Padding="22,7"
              AutomationProperties.Name="保存标签与歌词" />
      <Button Grid.Column="2" Content="关闭" Click="OnCloseClick" Padding="22,7"
              AutomationProperties.Name="关闭歌词编辑器" />
    </Grid>
  </Grid>
</Window>
